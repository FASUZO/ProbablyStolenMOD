<Project Sdk="Microsoft.NET.Sdk">

  <!-- 官方格式的 mod（正式版 1.0 起由游戏自带 mod 载入器加载，不需要 MelonLoader）。
       编译时参考游戏 Probably Stolen_Data\Managed 里的 Mono 程序集（只读，不随 mod 分发）。
       游戏不在默认位置时：dotnet build -c Release -p:GameDir="游戏文件夹"
       net48 是必须的：游戏是 Unity 2021.3 的 Mono（.NET 4.x）；
       扫描器会拒绝参考了 Managed 以外程序集的 mod。 -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AutoUvLamp</AssemblyName>
    <RootNamespace>AutoUvLamp</RootNamespace>
    <Version>2.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == ''">D:\Program Files (x86)\Steam\steamapps\common\Probably Stolen</GameDir>
    <ManagedDir>$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(ManagedDir)\0Harmony.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <!-- Unity 的模块程序集：UnityEngine.dll 只是门面，具体类型（JsonUtility、UI 元素等）
         在各自的 *Module.dll 里，不引用会报"找不到类型或命名空间"。 -->
    <Reference Include="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>

  <!-- net48 的引用程序集：机器上没装 .NET Framework 4.8 Targeting Pack 时也能编译，
       否则会报 "The reference assemblies for .NETFramework,Version=v4.8 were not found"。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
